# Copy to .env (gitignored) and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# DB password: initializes Postgres and serves the non-TLS fallback path (dev-mac / local).
# The containerized app no longer uses it — it authenticates with a client certificate (mutual TLS).
POSTGRES_PASSWORD=change-me
# HashiCorp Vault (dev mode, in-memory, bound to 127.0.0.1:8200 — local only).
# Root token used by the dev Vault + the cert-init bootstrap. The app gets a scoped token instead.
VAULT_DEV_ROOT_TOKEN_ID=root

# Optional overrides
# ANALYSIS_MODEL=claude-opus-5-5
# ANSWER_MODEL=claude-sonnet-5-5
# INGEST_WORKERS=2
# BANK_WORKERS=4
# Speech-to-text: auto picks Apple GPU (mlx, native Mac only) > NVIDIA (cuda) > cpu
# WHISPER_DEVICE=auto
# WHISPER_MODEL=large-v3-turbo                              # faster-whisper (cuda/cpu)
# WHISPER_MLX_MODEL=mlx-community/whisper-large-v3-turbo    # mlx-whisper (Apple GPU)
