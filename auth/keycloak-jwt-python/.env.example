# Copied to .env by fastapi-seerver/scripts/setup-local-dev.ps1 (or copy it yourself). .env is gitignored.
# Lab-only passwords: change them for anything real.

# --- Where Postgres runs -----------------------------------------------------------------
# Docker (default): keep COMPOSE_PROFILES=local-db and the KC_DB_URL below.
# Installed Postgres / AWS RDS: delete COMPOSE_PROFILES, point KC_DB_URL at it
#   (see README "Database"), and run postgres/create-databases.sql there once.
COMPOSE_PROFILES=local-db
POSTGRES_ADMIN_PASSWORD=postgres

# --- Database roles (created by postgres/create-databases.sql) ------------------------------
APP_DB_PASSWORD=app
KEYCLOAK_DB_PASSWORD=keycloak

# --- Keycloak's database, as seen from INSIDE Docker ------------------------------------------
KC_DB_URL=jdbc:postgresql://db:5432/keycloak
# KC_DB_URL=jdbc:postgresql://host.docker.internal:5432/keycloak                 # installed Postgres
# KC_DB_URL=jdbc:postgresql://<rds-endpoint>:5432/keycloak?sslmode=require       # AWS RDS
