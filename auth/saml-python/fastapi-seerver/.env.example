# Used for host-run tooling (pytest uses SQLite and never contacts the IdP). In Docker, the server gets
# its env from docker-compose.yml instead.
APP_NAME=fastapi-server
CORS_ORIGIN=http://localhost:8006
DATABASE_URL=postgresql+psycopg://app:app@localhost:5440/app
SP_BASE_URL=http://localhost:8006
SP_ENTITY_ID=http://localhost:8006/saml/metadata
IDP_METADATA_URL=http://localhost:8083/realms/saml-lab/protocol/saml/descriptor
SESSION_SECRET=saml-lab-dev-secret-change-me
