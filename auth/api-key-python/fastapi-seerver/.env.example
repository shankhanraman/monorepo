# Copied to .env by scripts/setup-local-dev.ps1 (or copy it yourself). .env is gitignored.
APP_NAME=fastapi-server
CORS_ORIGIN=http://localhost:5177

# Writes need the header  X-API-Key: <key>.  Migration 0002 seeds two demo keys:
#   active  : mial_live_demo_do_not_use_in_prod   (unlocks create / edit / delete)
#   revoked : mial_live_revoked_example           (inactive - demonstrates the 401 path)
DATABASE_URL=postgresql+psycopg://app:app@localhost:5438/app
# DATABASE_URL=postgresql+psycopg://app:<password>@localhost:5432/app   # installed Postgres
