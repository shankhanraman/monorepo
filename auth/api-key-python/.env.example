# Copied to .env by fastapi-seerver/scripts/setup-local-dev.ps1 (or copy it yourself). .env is gitignored.
# Lab-only passwords: change them for anything real.

# Docker (default): keep COMPOSE_PROFILES=local-db. Installed Postgres / RDS: delete it and point
# DATABASE_URL (fastapi-seerver/.env) at your server, then run postgres/create-databases.sql there once.
COMPOSE_PROFILES=local-db
POSTGRES_ADMIN_PASSWORD=postgres

# App database role (created by postgres/create-databases.sql)
APP_DB_PASSWORD=app
