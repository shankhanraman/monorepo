# Copied to .env by scripts/setup-local-dev.ps1 (or copy it yourself). .env is gitignored.
APP_NAME=fastapi-server
KEYCLOAK_ISSUER=http://localhost:8082/realms/bff-lab

# This backend is the OAuth 2.0 client. Lab-only secret, must match "secret" of client "bff" in keycloak/bff-lab-realm.json
OIDC_CLIENT_ID=bff
OIDC_CLIENT_SECRET=bff-lab-client-secret

# Public origin of the site (Vite proxies /api and /auth to this backend)
APP_URL=http://localhost:5175
# Signs the login-transaction cookie. Any long random string; the same on every instance.
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=8
# true behind HTTPS
COOKIE_SECURE=false

# App database, as seen from this machine. Password = APP_DB_PASSWORD in ../.env
DATABASE_URL=postgresql+psycopg://app:app@localhost:5436/app
# DATABASE_URL=postgresql+psycopg://app:<password>@localhost:5432/app                          # installed Postgres
# DATABASE_URL=postgresql+psycopg://app:<password>@<rds-endpoint>:5432/app?sslmode=require     # AWS RDS
